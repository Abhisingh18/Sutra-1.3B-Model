# Public URL of deploy/server.py. With cloudflared this is the https URL the
# tunnel prints; it changes on every restart unless you use a named tunnel.
NEXT_PUBLIC_API_URL=https://your-tunnel.trycloudflare.com

# Google sign-in. Optional -- without these the login page explains the setup
# and the chat carries on working anonymously.
#
#   console.cloud.google.com -> APIs & Services -> Credentials
#   -> Create OAuth client ID -> Web application
#   Authorised redirect URI:
#     https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# openssl rand -base64 32
AUTH_SECRET=
